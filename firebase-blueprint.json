{
  "entities": {
    "Place": {
      "title": "Place",
      "description": "A physical establishment or destination in Kenya.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the place." },
        "description": { "type": "string", "description": "Detailed description." },
        "location": { "type": "string", "description": "Geographical location string." },
        "category": { "type": "string", "enum": ["RESTAURANT", "ENTERTAINMENT", "HANGOUT_SPOTS", "OUTDOORS", "SAFARI", "ADVENTURES", "HOTEL", "EXPERIENCE"], "description": "Primary category." },
        "imageUrl": { "type": "string", "format": "uri", "description": "Main showcase image." },
        "price": { "type": "number", "description": "Starting or estimate price in KES." },
        "rating": { "type": "number", "description": "Current average rating." },
        "ownerId": { "type": "string", "description": "UID of the user who owns this listing." },
        "isTrending": { "type": "boolean", "description": "Whether the place is currently trending." },
        "isVerified": { "type": "boolean", "description": "Whether the place has been verified by admins." },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "Searchable tags." },
        "reviewsCount": { "type": "number", "description": "Total number of reviews for denormalization." },
        "numRatings": { "type": "number", "description": "Total count of ratings for denormalization." }
      },
      "required": ["name", "category", "ownerId"]
    },
    "Review": {
      "title": "Review",
      "description": "A user-submitted review for a place.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the reviewer." },
        "placeId": { "type": "string", "description": "ID of the place being reviewed." },
        "rating": { "type": "number", "minimum": 1, "maximum": 5, "description": "Star rating." },
        "comment": { "type": "string", "description": "Review textContent." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Time of submission." }
      },
      "required": ["userId", "placeId", "rating"]
    }
  },
  "firestore": {
    "/places/{placeId}": {
      "schema": "Place",
      "description": "Collection of all curated places and destinations."
    },
    "/places/{placeId}/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Subcollection of reviews for a specific place."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data."
    },
    "/registrations/{regId}": {
      "schema": "Registration",
      "description": "Partner registration applications."
    },
    "/operators/{id}": {
      "description": "Tour operator companies."
    },
    "/guides/{id}": {
      "description": "Individual tour guides."
    },
    "/providers/{id}": {
      "description": "Consolidated list of experience providers."
    },
    "/events/{id}": {
      "description": "Upcoming experiences and events."
    },
    "/itineraries/{id}": {
      "description": "User custom trip itineraries."
    }
  }
}
