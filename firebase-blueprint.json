{
  "entities": {
    "Place": {
      "title": "Place",
      "description": "A physical establishment or destination in Kenya.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the place." },
        "description": { "type": "string", "description": "Detailed description." },
        "location": { "type": "string", "description": "Geographical location string." },
        "category": { "type": "string", "description": "Primary category." },
        "imageUrl": { "type": "string", "format": "uri", "description": "Main showcase image." },
        "price": { "type": "number", "description": "Starting or estimate price in KES." },
        "rating": { "type": "number", "description": "Current average rating." },
        "ownerId": { "type": "string", "description": "UID of the user who owns this listing." },
        "isTrending": { "type": "boolean", "description": "Whether the place is currently trending." },
        "isVerified": { "type": "boolean", "description": "Whether the place has been verified by admins." },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "Searchable tags." },
        "status": { "type": "string", "enum": ["PUBLISHED", "DRAFT", "ARCHIVED"], "description": "Publishing status." }
      },
      "required": ["name", "category", "ownerId"]
    },
    "Event": {
      "title": "Event",
      "description": "An event or upcoming experience.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "location": { "type": "string" },
        "date": { "type": "string" },
        "price": { "type": "number" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["PUBLISHED", "DRAFT", "ARCHIVED"] }
      },
      "required": ["title", "date"]
    },
    "Category": {
      "title": "Category",
      "description": "Content classification category.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "displayOrder": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["name", "slug"]
    },
    "MediaAsset": {
      "title": "MediaAsset",
      "description": "Metadata for uploaded media files.",
      "type": "object",
      "properties": {
        "filename": { "type": "string" },
        "storagePath": { "type": "string" },
        "downloadURL": { "type": "string" },
        "contentType": { "type": "string" },
        "size": { "type": "number" },
        "uploadedAt": { "type": "string" },
        "altText": { "type": "string" },
        "caption": { "type": "string" }
      },
      "required": ["filename", "storagePath", "downloadURL"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Record of administrative actions.",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "adminUid": { "type": "string" },
        "adminEmail": { "type": "string" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["action", "adminUid"]
    }
  },
  "firestore": {
    "/places/{placeId}": {
      "schema": "Place",
      "description": "Collection of all curated places and destinations."
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Collection of upcoming events."
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Content category definitions."
    },
    "/media/{mediaId}": {
      "schema": "MediaAsset",
      "description": "Media library assets metadata."
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Administrative audit trail."
    },
    "/users/{userId}": {
      "description": "User profile data."
    },
    "/registrations/{regId}": {
      "description": "Partner registration applications."
    },
    "/operators/{id}": {
      "description": "Tour operator companies."
    },
    "/guides/{id}": {
      "description": "Individual tour guides."
    },
    "/site_config/main": {
      "description": "Global website configuration singleton."
    }
  }
}
