rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/(default)/documents/admins/$(request.auth.uid)); }

    // Public read for all assets
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User Uploads (logos, profile pics)
    match /uploads/{userId}/{allPaths=**} {
      allow write: if isSignedIn() && request.auth.uid == userId && request.resource.size < 5 * 1024 * 1024; // 5MB limit
    }
    
    // Registrations
    match /registrations/{regId}/{allPaths=**} {
      allow write: if isSignedIn() && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
