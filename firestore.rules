rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.admin == true || 
        request.auth.token.email == 'bikowrld21@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      ); 
    }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128; 
    }

    // 1. Places (Public Read, Owner/Admin Write)
    match /places/{placeId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() || (isSignedIn() && (existing() == null || existing().ownerId == request.auth.uid));

      // Reviews (Subcollection Pattern)
      match /reviews/{reviewId} {
        allow get, list: if true;
        allow create, update, delete: if isSignedIn();
      }
    }

    // 2. User Profiles
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isOwner(userId) || isAdmin();
      
      match /savedItems/{itemId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // 3. Registrations
    match /registrations/{regId} {
      allow create: if true;
      allow get, list, update, delete: if isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
    }

    // 4. Events
    match /events/{eventId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() || isSignedIn();
    }

    // 5. Providers, Operators, Guides
    match /providers/{id} { 
      allow get, list: if true;
      allow write: if isAdmin() || isSignedIn(); 
    }
    match /operators/{id} { 
      allow get, list: if true;
      allow write: if isAdmin() || isSignedIn(); 
    }
    match /guides/{id} { 
      allow get, list: if true;
      allow write: if isAdmin() || isSignedIn(); 
    }

    // 6. Categories & Media
    match /categories/{categoryId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    match /media/{mediaId} {
      allow get, list: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // 7. Site Configuration
    match /site_config/{docId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // 8. Audit Logs
    match /audit_logs/{logId} {
      allow get, list, create: if isAdmin();
    }

    // 9. Admins
    match /admins/{adminId} { 
      allow read: if isSignedIn(); 
      allow write: if isAdmin();
    }
  }
}


